{
  "expo": {
    "name": "Wanni Front",
    "slug": "wanni-front",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0c06",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0c06"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.awantha.wannifront",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Wanni Front uses the microphone only while you turn on voice chat in a co-op game."
      }
    },
    "android": {
      "package": "com.awantha.wannifront",
      "versionCode": 1,
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.MODIFY_AUDIO_SETTINGS"],
      "adaptiveIcon": {
        "backgroundColor": "#0a0c06",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    }
  }
}
